# --- Planning Center (Personal Access Token: https://api.planningcenteronline.com/personal_access_tokens) ---
PCO_APP_ID=
PCO_SECRET=
# Nombre exacto de los campos personalizados (pestaña "Cursos Bases" y "Desarrollo Personal")
FIELD_BASES1=Bases 1
FIELD_BASES2=Bases 2
FIELD_GC=GC Asignado
# Valores del campo que cuentan como "hecho" (separados por coma). Vacío = cualquier valor marcado.
BASES1_REQUIRED=
BASES2_REQUIRED=Asistencia Sesión 1,Asistencia Sesión 2
# Categoría de nota donde se escribe "Interesado en servir en X equipo" (se crea si no existe)
NOTE_CATEGORY_NAME=Interesado en servir

# --- Aplicación ---
PORT=3000
HOST=
APP_URL=https://equipos.hillsongspain.com
NODE_ENV=development
APP_TZ=Europe/Madrid
# Cadena larga y aleatoria (mínimo 32 caracteres)
SESSION_SECRET=
# Ruta de la base de datos SQLite (en producción, volumen persistente)
DB_PATH=./data/app.db

# --- Acceso al panel ---
# Contraseña común de líderes y voluntarios de Bases (cada uno entra con su email)
PANEL_PASSWORD=
# Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Enlaces que se incluyen en los emails ---
BASES1_URL=https://hillsong.es/bases1
BASES2_URL=https://hillsong.es/bases2
GC_URL=https://hillsong.es

# --- Email saliente (SMTP). Si SMTP_HOST está vacío los emails solo se escriben en el log. ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Únete al equipo <equipos@hillsongspain.com>
# Copia de seguridad de avisos cuando un equipo/ciudad no tiene líder
ADMIN_NOTIFY_EMAIL=

# --- Resumen semanal a líderes y voluntarios: día (0=domingo … 6=sábado) y hora local ---
DIGEST_DAY=1
DIGEST_HOUR=8
